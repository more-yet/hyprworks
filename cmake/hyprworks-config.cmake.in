@PACKAGE_INIT@

set(hyprworks_lua_FOUND @HYPRWORKS_BUILD_LUA@)
if(NOT @BUILD_SHARED_LIBS@)
    include(CMakeFindDependencyMacro)
    find_dependency(PkgConfig)
    foreach(dependency IN ITEMS @HYPRWORKS_NATIVE_DEPS@)
        string(REGEX REPLACE "[<>=].*" "" module "${dependency}")
        pkg_check_modules(HYPRWORKS_${module} QUIET IMPORTED_TARGET "${dependency}")
        if(NOT HYPRWORKS_${module}_FOUND)
            set(hyprworks_FOUND FALSE)
            set(hyprworks_NOT_FOUND_MESSAGE "Required native dependency: ${dependency}")
            return()
        endif()
    endforeach()
    if(hyprworks_lua_FOUND AND "lua" IN_LIST hyprworks_FIND_COMPONENTS)
        if(@HYPRWORKS_BUILD_GUI@)
            find_dependency(Threads)
        endif()
        foreach(dependency IN ITEMS @HYPRWORKS_LUA_DEPS@)
            string(REGEX REPLACE "[<>=].*" "" module "${dependency}")
            pkg_check_modules(HYPRWORKS_${module} QUIET IMPORTED_TARGET "${dependency}")
            if(NOT HYPRWORKS_${module}_FOUND)
                set(hyprworks_lua_FOUND FALSE)
                set(hyprworks_NOT_FOUND_MESSAGE "Required Lua dependency: ${dependency}")
                break()
            endif()
        endforeach()
    endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/hyprworks-targets.cmake")
if(hyprworks_lua_FOUND AND "lua" IN_LIST hyprworks_FIND_COMPONENTS)
    include("${CMAKE_CURRENT_LIST_DIR}/hyprworks-lua-targets.cmake")
endif()
check_required_components(hyprworks)
