@PACKAGE_INIT@

set(hyprworks_lua_FOUND @HYPRWORKS_BUILD_LUA@)
if(NOT @BUILD_SHARED_LIBS@)
    include(CMakeFindDependencyMacro)
    find_dependency(PkgConfig)
    pkg_check_modules(JSONC QUIET IMPORTED_TARGET json-c>=0.19)
    if(@HYPRWORKS_BUILD_UPOWER@ OR @HYPRWORKS_BUILD_MPRIS@ OR @HYPRWORKS_BUILD_NOTIFICATIONS@ OR @HYPRWORKS_BUILD_TRAY@ OR @HYPRWORKS_BUILD_COMMANDS@)
        pkg_check_modules(SYSTEMD QUIET IMPORTED_TARGET libsystemd>=262)
    endif()
    if(@HYPRWORKS_BUILD_AUDIO@)
        pkg_check_modules(PULSE QUIET IMPORTED_TARGET libpulse>=17.0)
    endif()
    if(@HYPRWORKS_BUILD_SHORTCUTS@)
        pkg_check_modules(WAYLAND_CLIENT QUIET IMPORTED_TARGET wayland-client>=1.26.0)
    endif()
    if(@HYPRWORKS_BUILD_DESKTOP@)
        pkg_check_modules(GIO QUIET IMPORTED_TARGET gio-unix-2.0>=2.90.1)
    endif()
    if(NOT JSONC_FOUND
        OR ((@HYPRWORKS_BUILD_UPOWER@ OR @HYPRWORKS_BUILD_MPRIS@ OR @HYPRWORKS_BUILD_NOTIFICATIONS@ OR @HYPRWORKS_BUILD_TRAY@ OR @HYPRWORKS_BUILD_COMMANDS@) AND NOT SYSTEMD_FOUND)
        OR (@HYPRWORKS_BUILD_AUDIO@ AND NOT PULSE_FOUND)
        OR (@HYPRWORKS_BUILD_SHORTCUTS@ AND NOT WAYLAND_CLIENT_FOUND)
        OR (@HYPRWORKS_BUILD_DESKTOP@ AND NOT GIO_FOUND))
        set(hyprworks_FOUND FALSE)
        set(hyprworks_NOT_FOUND_MESSAGE "A native dependency required by this Hyprworks build was not found: json-c, libsystemd, libpulse, wayland-client or gio-unix-2.0.")
        return()
    endif()
    if(hyprworks_lua_FOUND AND "lua" IN_LIST hyprworks_FIND_COMPONENTS)
        pkg_check_modules(LUA QUIET IMPORTED_TARGET lua>=5.5.1)
        if(@HYPRWORKS_BUILD_TOOLKIT@)
            pkg_check_modules(HYPRTOOLKIT QUIET IMPORTED_TARGET hyprtoolkit>=0.6.0)
            pkg_check_modules(XKBCOMMON QUIET IMPORTED_TARGET xkbcommon>=1.13.2)
        endif()
        if(NOT LUA_FOUND OR (@HYPRWORKS_BUILD_TOOLKIT@ AND NOT (HYPRTOOLKIT_FOUND AND XKBCOMMON_FOUND)))
            set(hyprworks_lua_FOUND FALSE)
            set(hyprworks_NOT_FOUND_MESSAGE "The Lua component requires Lua and, for toolkit builds, patched hyprtoolkit and xkbcommon.")
        endif()
    endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/hyprworks-targets.cmake")
if(hyprworks_lua_FOUND AND "lua" IN_LIST hyprworks_FIND_COMPONENTS)
    include("${CMAKE_CURRENT_LIST_DIR}/hyprworks-lua-targets.cmake")
endif()
check_required_components(hyprworks)
