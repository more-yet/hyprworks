+static constexpr size_t CLIPBOARD_LIMIT = 4 * 1024 * 1024;
+
+class CClipboardTransfer final : public IClipboardTransfer {
+  public:
+    ~CClipboardTransfer() override {
+        stop();
+    }
+
+    void stop() {
+        if (source)
+            source->remove();
+        source.reset();
+        timer.reset();
+        destroying.reset();
+        outgoing.reset();
+        text.clear();
+        callback = {};
+    }
+
+    void finish(std::expected<std::string, std::string> result) {
+        auto done = std::move(callback);
+        stop();
+        if (done)
+            done(std::move(result));
+    }
+
+    void dispatch(int fd) {
+        std::array<char, 16384> buffer;
+        for (size_t budget = 0; budget < 65536;) {
+            ssize_t count = 0;
+            if (outgoing) {
+                if (offset == outgoing->size()) {
+                    finish(std::string{});
+                    return;
+                }
+                // A peer can close the pipe between readiness and write. Consume only our new SIGPIPE.
+                sigset_t blocked, previous, pending;
+                sigemptyset(&blocked);
+                sigaddset(&blocked, SIGPIPE);
+                const int maskError = pthread_sigmask(SIG_BLOCK, &blocked, &previous);
+                if (maskError) {
+                    finish(std::unexpected(std::system_category().message(maskError)));
+                    return;
+                }
+                sigpending(&pending);
+                count           = write(fd, outgoing->data() + offset, std::min(outgoing->size() - offset, buffer.size()));
+                const int error = errno;
+                if (count < 0 && error == EPIPE && !sigismember(&pending, SIGPIPE)) {
+                    const timespec timeout{};
+                    sigtimedwait(&blocked, nullptr, &timeout);
+                }
+                pthread_sigmask(SIG_SETMASK, &previous, nullptr);
+                errno = error;
+            } else
+                count = read(fd, buffer.data(), buffer.size());
+
+            if (count > 0) {
+                budget += sc<size_t>(count);
+                if (outgoing)
+                    offset += sc<size_t>(count);
+                else {
+                    if (text.size() + sc<size_t>(count) > CLIPBOARD_LIMIT) {
+                        finish(std::unexpected("clipboard exceeds 4 MiB"));
+                        return;
+                    }
+                    text.append(buffer.data(), sc<size_t>(count));
+                }
+            } else if (count == 0) {
+                finish(std::move(text));
+                return;
+            } else if (errno == EAGAIN || errno == EWOULDBLOCK)
+                return;
+            else if (errno != EINTR) {
+                finish(std::unexpected(std::system_category().message(errno)));
+                return;
+            }
+        }
+    }
+
+    SP<Hyprutils::EventLoop::IFDSource>    source;
+    SP<Hyprutils::EventLoop::ITimer>       timer;
+    Hyprutils::Signal::CHyprSignalListener destroying;
+    SP<const std::string>                  outgoing;
+    std::string                            text;
+    size_t                                 offset = 0;
+    ClipboardCallback                      callback;
+};
+
+static SP<IClipboardTransfer> startClipboardTransfer(Hyprutils::OS::CFileDescriptor fd, SP<const std::string> outgoing, ClipboardCallback callback) {
+    const int flags = fcntl(fd.get(), F_GETFL);
+    if (flags < 0 || fcntl(fd.get(), F_SETFL, flags | O_NONBLOCK) < 0) {
+        callback(std::unexpected(std::system_category().message(errno)));
+        return {};
+    }
+    auto transfer                     = makeShared<CClipboardTransfer>();
+    transfer->outgoing                = std::move(outgoing);
+    transfer->callback                = std::move(callback);
+    const WP<CClipboardTransfer> weak = transfer;
+    auto source = g_waylandBackend->m_eventLoop->addFD(std::move(fd), transfer->outgoing ? Hyprutils::EventLoop::eEventMask::WRITABLE : Hyprutils::EventLoop::eEventMask::READABLE,
+                                                       [weak](Hyprutils::EventLoop::IFDSource& source, Hyprutils::EventLoop::FdEventMask) {
+                                                           if (const auto transfer = weak.lock())
+                                                               transfer->dispatch(source.fd().get());
+                                                       });
+    if (!source) {
+        transfer->finish(std::unexpected(source.error()));
+        return {};
+    }
+    transfer->source     = *source;
+    transfer->timer      = g_waylandBackend->m_eventLoop->addTimer(std::chrono::seconds(5), [weak](auto&) {
+        if (const auto transfer = weak.lock())
+            transfer->finish(std::unexpected("clipboard transfer timed out"));
+    });
+    transfer->destroying = g_backend->m_events.destroying.listen([weak] {
+        if (const auto transfer = weak.lock())
+            transfer->stop();
+    });
+    return transfer;
+}
