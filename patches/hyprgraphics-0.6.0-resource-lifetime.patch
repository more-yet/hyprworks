+std::expected<void, std::string> CAsyncResourceGatherer::enqueue(CAtomicSharedPointer<IAsyncResource> resource, std::function<void()> completed) {
+    std::lock_guard lock(m_mutex);
+    if (m_stopping)
+        return std::unexpected("resource queue is stopped");
+    if (m_requests.size() == CAPACITY)
+        return std::unexpected("resource queue is full");
+    if (resource->m_ready || resource->m_submitted.exchange(true))
+        return std::unexpected("resource was already submitted");
+    m_requests.push_back({std::move(resource), std::move(completed)});
+    m_wake.notify_one();
+    return {};
+}
+
+void CAsyncResourceGatherer::cancel(const CAtomicSharedPointer<IAsyncResource>& resource) {
+    std::function<void()> completed;
+    {
+        std::lock_guard lock(m_mutex);
+        resource->m_cancelled = true;
+        resource->m_cancelled.notify_all();
+        const auto request = std::ranges::find_if(m_requests, [&](const auto& item) { return item.resource == resource; });
+        if (request == m_requests.end())
+            return;
+        if (!request->started) {
+            resource->m_ready.store(true, std::memory_order_release);
+            resource->m_ready.notify_all();
+        }
+        completed = std::move(request->completed);
+        m_requests.erase(request);
+    }
+}
+
+int CAsyncResourceGatherer::fd() const {
+    return m_fd.get();
+}
+
+void CAsyncResourceGatherer::dispatch() {
+    uint64_t value = 0;
+    while (read(m_fd.get(), &value, sizeof(value)) < 0 && errno == EINTR) {}
+    // A callback can cancel another completion. Take one request at a time.
+    for (size_t count = 0; count < CAPACITY; ++count) {
+        SRequest completed;
+        {
+            std::lock_guard lock(m_mutex);
+            const auto      request = std::ranges::find_if(m_requests, [](const auto& item) { return item.done; });
+            if (request == m_requests.end())
+                return;
+            completed = std::move(*request);
+            m_requests.erase(request);
+        }
+        if (completed.completed)
+            completed.completed();
+    }
+}
+
+void CAsyncResourceGatherer::await(CAtomicSharedPointer<IAsyncResource> resource) {
+    resource->m_ready.wait(false, std::memory_order_acquire);
+}
+
+void CAsyncResourceGatherer::run() {
+    std::unique_lock lock(m_mutex);
+    for (;;) {
+        m_wake.wait(lock, [this] { return m_stopping || std::ranges::any_of(m_requests, [](const auto& request) { return !request.started; }); });
+        if (m_stopping)
+            return;
+        auto request     = std::ranges::find_if(m_requests, [](const auto& item) { return !item.started; });
+        request->started = true;
+        m_running        = request->resource;
+        lock.unlock();
+        try {
+            m_running->render();
+        } catch (const std::exception& error) { m_running->m_error = error.what(); } catch (...) {
+            m_running->m_error = "resource rendering failed";
+        }
+        lock.lock();
+        request = std::ranges::find_if(m_requests, [this](const auto& item) { return item.resource == m_running; });
+        if (request != m_requests.end()) {
+            request->done        = true;
+            const uint64_t value = 1;
+            while (write(m_fd.get(), &value, sizeof(value)) < 0 && errno == EINTR) {}
+        }
+        m_running->m_ready.store(true, std::memory_order_release);
+        m_running->m_ready.notify_all();
+        m_running.reset();
+    }
+}
